<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="22dp"
        android:paddingTop="20dp"
        android:paddingRight="22dp"
        android:paddingBottom="30dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="@string/settings"
                android:textColor="@color/ink"
                android:textSize="28sp" />

            <Button
                android:id="@+id/backButton"
                style="@style/Button.Outline"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minHeight="48dp"
                android:text="@string/back" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:lineSpacingExtra="3dp"
            android:text="QWeather 开发服务需要自行注册。注册后，在控制台查看专属 API Host，并创建 API Key。"
            android:textColor="@color/ink_muted"
            android:textSize="14sp" />

        <Button
            android:id="@+id/openConsoleButton"
            style="@style/Button.Outline"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="14dp"
            android:text="打开 QWeather 开发者控制台" />

        <TextView
            style="@style/Text.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="API Host" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="只填域名，不含 https:// 和末尾路径"
            android:textColor="@color/ink_muted"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/hostInput"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="9dp"
            android:background="@drawable/bg_edit"
            android:hint="例如：abcxyz.qweatherapi.com"
            android:inputType="textUri"
            android:maxLines="1"
            android:singleLine="true"
            android:textColor="@color/ink"
            android:textColorHint="@color/ink_faint"
            android:textSize="16sp" />

        <TextView
            style="@style/Text.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="API Key" />

        <EditText
            android:id="@+id/apiKeyInput"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="9dp"
            android:background="@drawable/bg_edit"
            android:hint="粘贴 API Key"
            android:inputType="textPassword"
            android:maxLines="1"
            android:singleLine="true"
            android:textColor="@color/ink"
            android:textColorHint="@color/ink_faint"
            android:textSize="16sp" />

        <Button
            android:id="@+id/saveButton"
            style="@style/Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="20dp"
            android:text="保存设置" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="24dp"
            android:textColor="@color/ink_muted"
            android:textSize="13sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="@color/ink_faint" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:lineSpacingExtra="3dp"
            android:text="隐私与墨水屏说明\nAPI Key 仅保存在本机应用私有目录，不写入日志。应用不请求定位权限，仅在打开应用或手动点击刷新时请求天气，不进行后台轮询。"
            android:textColor="@color/ink_muted"
            android:textSize="12sp" />

        <Button
            android:id="@+id/clearCacheButton"
            style="@style/Button.Outline"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="18dp"
            android:text="清除天气缓存" />
    </LinearLayout>
</ScrollView>
